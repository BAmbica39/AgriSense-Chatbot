# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=chatbot_users

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Google Gemini (backend only - never put this key in the frontend).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Model used for answers; change it here without touching the code.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048

# Cost controls: earlier messages sent as context, and questions allowed per user per minute.
CHAT_HISTORY_MESSAGES=6
CHAT_REQUESTS_PER_MINUTE=10

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
